གྲངས་[] སློབ་ཕྲུག་གི་སྐར་གྲངས་ = [༧༥, ༨༠, ༦༥, ༩༠, ༥༥];
གྲངས་ བསྡོམས་ = ༠;
གྲངས་ ཨང་རྩིས་ = ༠;

ཡང་བསྐྱར་ (ཨང་རྩིས་ < རིང་ཚད(སློབ་ཕྲུག་གི་སྐར་གྲངས་)) {
    བསྡོམས་ = བསྡོམས་ + སློབ་ཕྲུག་གི་སྐར་གྲངས་[ཨང་རྩིས་];
    ཨང་རྩིས་ = ཨང་རྩིས་ + ༡;
}

གྲངས་ ཆ་སྙོམས་ = བསྡོམས་ / རིང་ཚད(སློབ་ཕྲུག་གི་སྐར་གྲངས་);
བཀོད་ ཆ་སྙོམས་;

གལ་སྲིད་ (ཆ་སྙོམས་ >= ༦༠) {
    བཀོད་ "འགྲུབ་སོང་།";
} མེད་ན་ {
    བཀོད་ "མ་འགྲུབ།";
}
