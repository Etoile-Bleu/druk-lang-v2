ལས་འགན་ is_even(གྲངས་ n) {
    གྲངས་ half = n / ༢;
    གྲངས་ doubled = half * ༢;
    སླར་ལོག་ doubled == n;
}

གྲངས་[] numbers = [༡, ༢, ༣, ༤, ༥, ༦];
གྲངས་ i = ༠;
ཡང་བསྐྱར་ (i < རིང་ཚད(numbers)) {
    གལ་སྲིད་ (is_even(numbers[i])) {
        བཀོད་ "even";
    } མེད་ན་ {
        བཀོད་ "odd";
    }
    i = i + ༡;
}
