# install.sh is fetched raw (curl ... | sh) and run by a POSIX shell; a
# CRLF line ending on its shebang line would make that fail with "sh\r:
# No such file or directory" on some systems, so its line endings are
# pinned to LF regardless of any platform's core.autocrlf setting.
install.sh text eol=lf

# insta snapshots are compared against captured stdout that this project
# already normalizes to LF before asserting (see crates/druk/tests/
# examples.rs); pinning the files themselves to LF too means a Windows
# contributor's local checkout and a Windows CI runner's checkout can
# never diverge from a Linux one on line endings alone.
*.snap text eol=lf
